# Example .env for Dokploy Templates (Blueprints)
# These variables are commonly used across various templates in this repository.

# PostgreSQL Configuration
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=dokploy_db
POSTGRES_HOST=supabase-db

# Supabase Specifics
ANON_KEY=your_supabase_anon_key
SERVICE_ROLE_KEY=your_supabase_service_role_key
JWT_SECRET=your_jwt_secret
SITE_URL=https://your-app.com
API_EXTERNAL_URL=https://your-api.com

# AI / ML Configuration for Infomaniak
INFOMANIAK_PROJECT_ID=your_infomaniak_project_id
OPENAI_API_BASE=https://api.infomaniak.com/2/ai/${INFOMANIAK_PROJECT_ID}/openai/v1
OPENAI_API_KEY=your_openai_api_key

# General Service Configuration
ADMIN_USER=admin
ADMIN_PASSWORD=admin_password
GLEAN_SECRET_KEY=your_glean_secret
SURF_SECRET_KEY=your_surf_secret
SECRET_KEY_BASE=your_secret_key_base

# Domain / Hosts
GLEAN_HOST=glean.yourdomain.com
GLEAN_ADMIN_HOST=admin.glean.yourdomain.com
MAUTIC_DB_PASSWORD=your_mautic_db_password

# Infomaniak S3 Configuration (for Docker Registry and others)
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_REGION=us-east-1
S3_BUCKET=your_s3_bucket_name
S3_ENDPOINT=https://s3.cloud.infomaniak.net